# ---------------------------------------------------------------------------
# polbot environment configuration
# Copy to `.env` and fill in. NEVER commit your real .env file.
# ---------------------------------------------------------------------------

# === Strategy / behaviour (all optional, defaults shown) -------------------
POLBOT_ASSET=btc                  # btc | eth | sol | xrp
POLBOT_SIZE_PER_LEVEL=5           # shares per ladder level (CLOB min is 5)
POLBOT_MIN_PRICE=0.01             # lowest ladder level
POLBOT_MAX_PRICE=0.99             # highest ladder level
POLBOT_REFRESH_S=5                # cancel & repost cadence in seconds
POLBOT_PULL_S=60                  # pull all orders N seconds before window end
POLBOT_JOIN_DELAY_S=5             # wait N seconds after window open before quoting
POLBOT_MAX_COST=250               # stop quoting when market spend (incl. resting) exceeds this
POLBOT_MAX_SHARES_SIDE=500        # stop quoting a side once inventory exceeds this
POLBOT_DAILY_LOSS=250             # halt the bot after this much realized daily loss
POLBOT_DRY_RUN=1                  # 1 = paper mode (default, no real orders), 0 = LIVE

# === Live trading credentials (only needed when POLBOT_DRY_RUN=0) ----------
# Private key of the wallet that SIGNS orders (exported from your Polymarket wallet).
POLYMARKET_PRIVATE_KEY=
# Optional: the funder / proxy wallet address that HOLDS the funds
# (required for email/Magic or browser-proxy wallets, i.e. signature types 1/2).
POLYMARKET_WALLET=

# === Endpoints (rarely changed) --------------------------------------------
POLBOT_GAMMA_URL=https://gamma-api.polymarket.com
POLBOT_CLOB_URL=https://clob.polymarket.com

# ---- v2 mm engine (polbot mm-run) ----
# Live mode only. Paper mode (default) needs no credentials.
POLBOT_PRIVATE_KEY=          # signer key for the mm engine
POLBOT_FUNDER=               # polymarket.com proxy/safe wallet address (if any)
POLBOT_SIGNATURE_TYPE=0      # 0 EOA | 1 proxy | 2 safe
POLBOT_MODE=paper            # paper | live
POLBOT_LIVE_UNLOCK=          # must equal I-UNDERSTAND-THE-RISK for live mode
